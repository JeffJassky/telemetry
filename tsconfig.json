{
  "// ": "Checks the TS source AND the hand-written public declarations. The",
  "//  ": "published contract is types/*.d.ts (never generated — house-style);",
  "//   ": "types/test-d.ts is the thing that actually exercises it. tsup does",
  "//    ": "the emitting, so noEmit here.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/client/**/*.ts", "types/**/*.d.ts", "types/test-d.ts"],
  "exclude": ["src/ui/**"]
}
