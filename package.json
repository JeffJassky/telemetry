{
  "name": "@jeffjassky/telemetry",
  "version": "0.0.0",
  "description": "Unified telemetry — product events, errors, traces, state transitions, and billable usage in one Mongo envelope, with typed SDKs and a mountable dashboard.",
  "license": "MIT",
  "author": "Jeff Jassky <jeff@jeffjassky.com>",
  "homepage": "https://jeffjassky.github.io/telemetry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffJassky/telemetry.git"
  },
  "bugs": {
    "url": "https://github.com/JeffJassky/telemetry/issues"
  },
  "keywords": [
    "telemetry",
    "mongodb",
    "mongoose",
    "express",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsup",
    "build:ui": "vite build --config src/ui/vite.config.js",
    "dev:server": "tsup --watch",
    "dev:ui": "vite --config src/ui/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-tracked": "node scripts/check-tracked.mjs",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "mongoose": "^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.0",
    "@vitejs/plugin-react": "^4.3.0",
    "express": "^5.2.1",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "^9.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitepress": "^1.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
